server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Same-origin API: the browser only ever talks to this host. API_UPSTREAM
    # (e.g. http://10.0.0.5:8001) is filled in from the environment at start.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        # $http_host keeps the port, so the API's Origin check matches.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # add_header in a location replaces inherited ones, so every location
    # that sets a header includes the security set again.
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, immutable";
        expires 1y;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
