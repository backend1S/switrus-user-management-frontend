# Base path the UI uses for API calls. Keep "/api" so requests stay same-origin
# (Vite dev proxy / nginx forward them to the backend). Never put secrets here:
# every VITE_* value is compiled into the public JavaScript bundle.
VITE_API_BASE_URL=/api

# Dev server only: where Vite proxies /api to.
API_PROXY_TARGET=http://localhost:8001

# Docker only: where nginx forwards /api (the backend's address as seen from the container).
API_UPSTREAM=http://host.docker.internal:8001
WEB_PORT=8080
